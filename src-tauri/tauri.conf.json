{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qwen Image Studio",
  "version": "0.1.0",
  "identifier": "dev.limeflash.qwen-image-studio",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Qwen Image Studio",
        "width": 900,
        "height": 640,
        "resizable": false,
        "maximizable": false,
        "theme": "Dark",
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "limeflash",
    "copyright": "MIT. Model weights remain under the Qwen Research License.",
    "shortDescription": "Local Qwen-Image-2.1 as an MCP server for Claude",
    "longDescription": "Runs Qwen-Image-2.1 on your own GPU and exposes it to Claude as an MCP server. The model weights (~15 GB) are downloaded on first run, to a folder you choose.",
    "category": "Graphics",
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}